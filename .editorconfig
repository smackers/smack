root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,cc,hh}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{cmake,cmake.in}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[{*.bpl,*.ll,*.bc}]
# Test artifacts — don't normalize what regtest greps for.
trim_trailing_whitespace = false
insert_final_newline = false

[sea-dsa/**]
# Vendored.
trim_trailing_whitespace = false
insert_final_newline = false
